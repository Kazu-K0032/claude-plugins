{
  "description": "セッションの開始時に、kazu マーケットプレイスのプラグインの不具合・改善案を作業の区切りで起票するよう提案させる文面を Claude の文脈に入れる",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/plugin-feedback.js\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
