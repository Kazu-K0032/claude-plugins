{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**/*.example)",
      "Edit(./**/*.example)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./.envrc)",
      "Read(./.envrc.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.tfvars.json)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/.terraform/**)",
      "Read(./secrets/**)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git -C * commit*)",
      "Bash(git -C * push*)",
      "Bash(git -c * commit*)",
      "Bash(git -c * push*)",
      "Edit(./.git/**)",
      "Edit(./**/.git/**)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(find * -delete*)",
      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(git tag -d*)",
      "Bash(git tag --delete*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git worktree remove *)",
      "PowerShell(Remove-Item *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *enablePullRequestAutoMerge*)",
      "Bash(gh api */merges*)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *--delete-branch*)",
      "Bash(gh issue delete *)",
      "Bash(gh issue comment *--delete-last*)",
      "Bash(gh pr comment *--delete-last*)",
      "Bash(gh label delete *)",
      "Bash(gh cache delete *)",
      "Bash(gh run delete *)",
      "Bash(gh gist delete *)",
      "Bash(gh api *DELETE*)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun*)",
      "Bash(gh issue comment *@claude*)",
      "Bash(gh pr comment *@claude*)",
      "Bash(gh api *@claude*)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo unarchive*)",
      "Bash(gh repo fork*)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh secret remove *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth switch*)",
      "Bash(gh auth setup-git*)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git remote *)",
      "PowerShell(git -C * commit*)",
      "PowerShell(git -C * push*)",
      "PowerShell(git -c * commit*)",
      "PowerShell(git -c * push*)",
      "PowerShell(git rm *)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -d*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git branch --delete*)",
      "PowerShell(git tag -d*)",
      "PowerShell(git tag --delete*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(git worktree remove *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh api *pulls/*/merge*)",
      "PowerShell(gh api *mergePullRequest*)",
      "PowerShell(gh api *enablePullRequestAutoMerge*)",
      "PowerShell(gh api */merges*)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh pr close *--delete-branch*)",
      "PowerShell(gh issue delete *)",
      "PowerShell(gh issue comment *--delete-last*)",
      "PowerShell(gh pr comment *--delete-last*)",
      "PowerShell(gh label delete *)",
      "PowerShell(gh cache delete *)",
      "PowerShell(gh run delete *)",
      "PowerShell(gh gist delete *)",
      "PowerShell(gh api *DELETE*)",
      "PowerShell(gh release *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh run rerun*)",
      "PowerShell(gh issue comment *@claude*)",
      "PowerShell(gh pr comment *@claude*)",
      "PowerShell(gh api *@claude*)",
      "PowerShell(gh repo create *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo deploy-key *)",
      "PowerShell(gh repo rename*)",
      "PowerShell(gh repo archive*)",
      "PowerShell(gh repo unarchive*)",
      "PowerShell(gh repo fork*)",
      "PowerShell(gh secret set *)",
      "PowerShell(gh secret delete *)",
      "PowerShell(gh secret remove *)",
      "PowerShell(gh variable set *)",
      "PowerShell(gh variable delete *)",
      "PowerShell(gh ssh-key *)",
      "PowerShell(gh gpg-key *)",
      "PowerShell(gh auth login *)",
      "PowerShell(gh auth logout *)",
      "PowerShell(gh auth refresh *)",
      "PowerShell(gh auth switch*)",
      "PowerShell(gh auth setup-git*)",
      "PowerShell(rm *)",
      "PowerShell(rmdir *)",
      "PowerShell(del *)",
      "PowerShell(rd *)",
      "PowerShell(ri *)",
      "PowerShell(erase *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-destructive.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-claude-mention.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true
  }
}
